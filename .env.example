# MongoDB Connection
# Option 1: Local MongoDB (if MongoDB is running locally on port 27017)
# MONGODB_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud) - RECOMMENDED
# Replace the values below with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority

# Gemini AI Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key-here>

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=<your-secret-key-here>

# ML Model Path
ML_MODEL_PATH=./stress_model.pkl

# Application Settings
DEBUG=false
PORT=5000
